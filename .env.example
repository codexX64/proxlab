# ProxLab : copier en .env, puis remplir. Chaque secret peut aussi venir d'un
# fichier : NOM_FILE=/chemin (convention des secrets Docker).

# Port publié sur la boucle locale de l'hôte par docker-compose.yml.
PROXLAB_PORT=8140

# Jeton de service du Hub : ouvre l'état résumé, les événements et trois gestes
# d'alimentation (démarrer, arrêter proprement, redémarrer) — jamais les
# comptes, la liaison ni les alertes. Vide : aucune route du Hub.
# Génère-le :  openssl rand -hex 24
PROXLAB_HUB_TOKEN=

# Passe de surveillance (secondes, 15 à 3600) et rétention des événements
# (jours, 1 à 365).
PROXLAB_INTERVAL=60
PROXLAB_EVENTS_DAYS=30

# Comptes (socle commun). Accès sans HTTPS : 1 seulement sur un réseau de
# confiance ; les clés d'accès n'existent qu'en HTTPS.
SOCLE_HTTP=0
# Jeton qui permet de créer le premier compte. Vide : tiré au premier
# démarrage et écrit dans les journaux du conteneur.
SOCLE_JETON_INSTALLATION=
# Relais inverses autorisés à transmettre l'adresse du client (CIDR).
SOCLE_PROXYS=
# Gamme de l'interface : soma, console ou exploitation.
SOCLE_THEME=soma

# Alertes de sécurité des comptes par courriel (facultatif).
SOCLE_URL_PUBLIQUE=
SOCLE_SMTP_HOTE=
SOCLE_SMTP_PORT=
SOCLE_SMTP_SECURITE=tls
SOCLE_SMTP_UTILISATEUR=
SOCLE_SMTP_MOTDEPASSE=
SOCLE_SMTP_DE=
